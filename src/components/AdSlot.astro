---
// Controlled ad placement component. Authors never paste ad markup into
// Markdown; every placement goes through this component, which stays a
// no-op until PUBLIC_ADSTERRA_ENABLED is configured.
//
// Required env (set in Cloudflare Pages project settings, not committed):
//   PUBLIC_ADSTERRA_ENABLED      "false" to disable ads entirely
//
// Defaults below are the Adsterra embed you provided. They ship in the page
// source by design (Adsterra publisher/channel IDs are public), but you can
// override any of them with PUBLIC_ variables in your deploy.
//
// Per-placement usage:
//   <AdSlot placement="below-intro" />
//   <AdSlot placement="after-article" />
interface Props {
  placement?: "below-intro" | "in-article" | "after-article" | "sidebar";
}
const { placement = "after-article" } = Astro.props;

const enabled = import.meta.env.PUBLIC_ADSTERRA_ENABLED !== "false";

// Adsterra embed (non-blocking, static banner — never covers article text).
const scriptA =
  import.meta.env.PUBLIC_ADSTERRA_SCRIPT_A ||
  "https://abscloud.org/1/853d4092a34dbea36933ac7c98f7c207";
const scriptB =
  import.meta.env.PUBLIC_ADSTERRA_SCRIPT_B ||
  "https://bauval.org/14/4b22c56307299d41158873e9fd0012b1";
const scriptC =
  import.meta.env.PUBLIC_ADSTERRA_SCRIPT_C ||
  "https://bauval.org/21/5f176775a9b013d3e613fee01a66cf03";
const containerId =
  import.meta.env.PUBLIC_ADSTERRA_CONTAINER_ID ||
  "container-5f176775a9b013d3e613fee01a66cf03";
---
{enabled && (
  <div class={`ad-slot ad-slot--${placement}`} data-placement={placement}>
    <p class="ad-label">Advertisement</p>
    <script data-cfasync="false" src={scriptA}></script>
    <script data-cfasync="false" src={scriptB}></script>
    <script async data-cfasync="false" src={scriptC}></script>
    <div id={containerId}></div>
  </div>
)}
