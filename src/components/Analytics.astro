---
// GA4 measurement ID. Public by design, so it is hardcoded as the production
// default (keeping `astro dev` silent) and still overridable via PUBLIC_GA_ID.
const gaId =
  import.meta.env.PUBLIC_GA_ID ||
  (import.meta.env.PROD ? "G-YF24KHNCYC" : "");
---
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", gaId, { anonymize_ip: true });
    </script>
  </>
)}
