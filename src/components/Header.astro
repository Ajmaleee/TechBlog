---
const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a href="/" class="brand">Embedded &amp; Circuits</a>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
      <a href="/search/">Search</a>
      <a href="/rss.xml">RSS</a>
    </nav>

    <div style="display:flex; gap: 0.5rem; align-items:center;">
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode" type="button">
        <svg id="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
      </button>
      <button class="icon-btn nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var stored = localStorage.getItem("theme");
    if (stored) document.documentElement.setAttribute("data-theme", stored);

    document.getElementById("theme-toggle")?.addEventListener("click", function () {
      var root = document.documentElement;
      var current = root.getAttribute("data-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      var next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (e) {}
    });

    var navToggle = document.getElementById("nav-toggle");
    var nav = document.getElementById("main-nav");
    navToggle?.addEventListener("click", function () {
      var open = nav.classList.toggle("open");
      navToggle.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
