---
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/SEO.astro";
import AdSlot from "../components/AdSlot.astro";
import PostCard from "../components/PostCard.astro";
import { formatDate, readingTime, slugify, type Post } from "../utils/posts";

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
  rawBody: string;
  prev?: Post | null;
  next?: Post | null;
  related: Post[];
}
const { post, headings, rawBody, prev, next, related } = Astro.props;
const { data } = post;
const path = `/blog/${post.slug}/`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const coverSrc = data.cover;
const contactEmail = "ajmalsworkshop@gmail.com";
const AD_SLOT_BELOW_INTRO = import.meta.env.PUBLIC_ADSENSE_SLOT_BELOW_INTRO ?? "";
const AD_SLOT_AFTER_ARTICLE = import.meta.env.PUBLIC_ADSENSE_SLOT_AFTER_ARTICLE ?? "";
---
<BaseLayout>
  <SEO
      slot="head"
      title={data.seoTitle || `${data.title} | Embedded & Circuits`}
      description={data.seoDescription || data.description}
      path={path}
      image={coverSrc}
      type="article"
      publishedDate={data.date}
      modifiedDate={data.updated}
      tags={data.tags}
      noindex={data.noindex}
      canonicalUrl={data.canonicalUrl}
    />

  <div class="container" style="padding-top: var(--space-6);">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/blog/">Articles</a> / <a href={`/blog/category/${slugify(data.category)}/`}>{data.category}</a>
    </nav>
  </div>

  <div class="article-shell">
    <aside class="article-aside" aria-label="On this page">
      {toc.length > 2 && (
        <>
          <p class="aside-title">On this page</p>
          <ul class="aside-list">
            {toc.map((h) => (
              <li class={h.depth === 3 ? "depth-3" : undefined}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </>
      )}
      <div style="margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-border);">
        <p class="aside-title">Tags</p>
        <div class="tag-cloud">
          {data.tags.map((tag) => (
            <a class="badge" href={`/blog/tag/${slugify(tag)}/`}>{tag}</a>
          ))}
        </div>
      </div>
    </aside>

    <article class="article-main">
      <header class="article-header">
        <span class="kicker">{data.category}</span>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <div class="byline">
          <span class="author">By {data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          {data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readingTime(rawBody)}</span>
        </div>
      </header>

      <figure class="article-hero">
        <img src={coverSrc} alt={data.coverAlt || data.title} width="1200" height="675" />
        {data.coverAlt && <figcaption>{data.coverAlt}</figcaption>}
      </figure>

      {toc.length > 2 && (
        <details class="toc toc-inline" open>
          <summary>Table of contents</summary>
          <ul>
            {toc.map((h) => (
              <li style={h.depth === 3 ? "margin-left: 1rem;" : undefined}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <AdSlot adSlot={AD_SLOT_BELOW_INTRO} placement="below-intro" />

      <div class="article-body">
        <slot />
      </div>

      <AdSlot adSlot={AD_SLOT_AFTER_ARTICLE} placement="after-article" />

      <div class="author-box">
        <div class="author-box__avatar" aria-hidden="true">A</div>
        <div>
          <h3>Ajmal Ali</h3>
          <p>
            A self-taught electronics hobbyist documenting Arduino, ESP32, and
            sensor projects as he learns. Spot an error? Email
            <a href={`mailto:${contactEmail}`}> {contactEmail}</a>.
          </p>
        </div>
      </div>

      {related.length > 0 && (
        <section aria-labelledby="related-heading">
          <div class="section-head">
            <h2 id="related-heading">Related Articles</h2>
          </div>
          <div class="post-grid">
            {related.map((r) => <PostCard post={r} />)}
          </div>
        </section>
      )}

      <nav class="post-nav" aria-label="Article navigation">
        {prev ? (
          <a href={`/blog/${prev.slug}/`}>
            <div class="direction">← Previous</div>
            {prev.data.title}
          </a>
        ) : <span></span>}
        {next ? (
          <a href={`/blog/${next.slug}/`} class="next">
            <div class="direction">Next →</div>
            {next.data.title}
          </a>
        ) : <span></span>}
      </nav>
    </article>

    <div class="article-share" aria-label="Share this article">
      <button class="share-btn" type="button" data-share="x" aria-label="Share on X" title="Share on X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.1 8.1L23.3 22h-6.6l-5.2-6.8L5.6 22H2.5l7.6-8.7L1.1 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z"/></svg>
      </button>
      <button class="share-btn" type="button" data-share="facebook" aria-label="Share on Facebook" title="Share on Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.2C16.7.2 15.7 0 14.5 0 12 0 10.5 1.5 10.5 4.2V6H8v3h2.5v9H14V9Z"/></svg>
      </button>
      <button class="share-btn" type="button" data-share="linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 10.7 21 13.6V21h-4v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.53 1.72-2.53 3.49V21H9V9Z"/></svg>
      </button>
      <button class="share-btn" type="button" data-share="copy" aria-label="Copy link" title="Copy link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      var url = encodeURIComponent(window.location.href);
      var title = encodeURIComponent(document.title);
      var targets = {
        x: "https://twitter.com/intent/tweet?url=" + url + "&text=" + title,
        facebook: "https://www.facebook.com/sharer/sharer.php?u=" + url,
        linkedin: "https://www.linkedin.com/sharing/share-offsite/?url=" + url,
      };
      document.querySelectorAll("[data-share]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var kind = btn.getAttribute("data-share");
          if (kind === "copy") {
            navigator.clipboard.writeText(window.location.href).then(function () {
              var prev = btn.getAttribute("title");
              btn.setAttribute("title", "Copied!");
              setTimeout(function () { btn.setAttribute("title", prev); }, 1600);
            });
            return;
          }
          if (targets[kind]) window.open(targets[kind], "_blank", "noopener,width=640,height=560");
        });
      });

      // Highlight the current section in the sticky TOC while scrolling.
      var links = document.querySelectorAll(".aside-list a");
      var sections = Array.prototype.map.call(links, function (link) {
        return document.getElementById(decodeURIComponent(link.getAttribute("href").slice(1)));
      });
      if (sections.length) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            links.forEach(function (l) { l.classList.remove("active"); });
            var idx = sections.indexOf(entry.target);
            if (idx > -1) links[idx].classList.add("active");
          });
        }, { rootMargin: "-80px 0px -70% 0px" });
        sections.forEach(function (s) { if (s) observer.observe(s); });
      }
    })();
  </script>
</BaseLayout>
