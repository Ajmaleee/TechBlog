---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import ConsentMode from "../components/ConsentMode.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

interface Props {
  bodyClass?: string;
}
const { bodyClass = "" } = Astro.props;

// Site-wide integration IDs. All of these are public by design — they ship
// in the page source — so they are hardcoded here as production defaults and
// no longer depend on Cloudflare Pages injecting environment variables at
// build time. `astro dev` stays clean (no analytics/ad tags); any PUBLIC_
// variable still overrides the default, so a deploy can disable ads, etc.
const isProd = import.meta.env.PROD;
const adsenseClientId =
  import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || (isProd ? "ca-pub-7330488077866990" : "");
const adsenseEnabled = Boolean(adsenseClientId) && import.meta.env.PUBLIC_ADSENSE_ENABLED !== "false";
const gscVerification =
  import.meta.env.PUBLIC_GSC_VERIFICATION || (isProd ? "cJOirbfsFuMeRRtCq3G9SyQtf0XY58iZV5zO4hc1dnY" : "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Embedded & Circuits RSS Feed" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <slot name="head" />
    <ConsentMode />
    {adsenseEnabled && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link visually-hidden">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script src="/scripts/code-copy.js" is:inline defer></script>
    <script src="/scripts/image-fallback.js" is:inline defer></script>
  </body>
</html>
