---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import ConsentMode from "../components/ConsentMode.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

interface Props {
  bodyClass?: string;
}
const { bodyClass = "" } = Astro.props;

const isProd = import.meta.env.PROD;
const gscVerification =
  import.meta.env.PUBLIC_GSC_VERIFICATION || (isProd ? "cJOirbfsFuMeRRtCq3G9SyQtf0XY58iZV5zO4hc1dnY" : "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Embedded & Circuits RSS Feed" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <slot name="head" />
    <ConsentMode />
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link visually-hidden">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script src="/scripts/code-copy.js" is:inline defer></script>
    <script src="/scripts/image-fallback.js" is:inline defer></script>
  </body>
</html>
