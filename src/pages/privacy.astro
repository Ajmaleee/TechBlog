---
import BaseLayout from "../layouts/BaseLayout.astro";
import SEO from "../components/SEO.astro";
const LAST_UPDATED = "2026-09-21";
---
<BaseLayout>
  <SEO slot="head" title="Privacy Policy | Embedded & Circuits" description="How this site handles data." path="/privacy/" noindex={false} />
  <div class="prose-container article-body" style="padding: var(--space-8) 0;">
    <h1>Privacy Policy</h1>
    <p class="text-muted">Last updated: {LAST_UPDATED}</p>

    <p>
      <strong>This is a template, not legal advice.</strong> Replace the
      bracketed sections below to match what this site actually does before
      publishing. Consult a lawyer if you need this to be legally binding for
      your jurisdiction (e.g. GDPR, CCPA).
    </p>

    <h2>What this site collects</h2>
    <p>
      This site is static and does not require an account to read. Depending
      on configuration, the following third-party services may be active:
    </p>
    <ul>
      <li>
        <strong>Analytics</strong> — enabled only if <code>PUBLIC_GA_ID</code> is
        configured. When active, Google Analytics collects anonymized usage
        data such as pages visited, approximate location, and device type.
      </li>
      <li>
        <strong>Advertising</strong> — enabled only if
        <code>PUBLIC_ADSENSE_CLIENT_ID</code> is configured. Google AdSense may
        use cookies to serve ads, including personalized ads, and may collect
        data as described in
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">
          Google's Partner Sites policy
        </a>.
      </li>
      <li>
        <strong>Hosting</strong> — this site is served by Cloudflare, which
        may log standard request data (IP address, user agent) for security
        and performance purposes. See
        <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">Cloudflare's privacy policy</a>.
      </li>
    </ul>

    <h2>Cookies</h2>
    <p>
      This site sets no cookies of its own. Third-party services listed above may
      set cookies or use similar technologies when they are enabled:
    </p>
    <ul>
      <li>
        <strong>Google Analytics (GA4)</strong> sets cookies to measure traffic and
        understand how visitors use the site. IP addresses are anonymised. You can
        opt out with the Google Analytics Opt-out Add-on.
      </li>
      <li>
        <strong>Google AdSense</strong> may set cookies to serve and measure ads,
        including personalised ads based on your prior visits to this or other
        websites. You can opt out of personalised ads in your
        <a href="https://adssettings.google.com/" rel="nofollow noopener"
          >Google Ads Settings</a
        >, or opt out of third-party vendor cookies at
        <a href="https://www.aboutads.info/choices/" rel="nofollow noopener"
          >aboutads.info</a
        >.
      </li>
      <li>
        <strong>Cloudflare</strong> may process request logs to deliver the site
        and serve pages securely.
      </li>
    </ul>
    <p>
      No cookie-consent banner is shown. If you are in a jurisdiction that requires
      prior consent for non-essential cookies, block them with your browser or an
      extension such as uBlock Origin — the site remains fully readable without
      them, and no advertising or analytics scripts will run.
    </p>

    <h2>Your choices</h2>
    <p>
      You can disable cookies in your browser, use browser extensions to
      block trackers, or use Google's
      <a href="https://adssettings.google.com/" target="_blank" rel="noopener">Ad Settings</a>
      to opt out of personalized advertising.
    </p>

    <h2>Contact</h2>
    <p>Questions about this policy: see the <a href="/contact/">contact page</a>.</p>
  </div>
</BaseLayout>
