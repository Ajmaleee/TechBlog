---
import BaseLayout from "../layouts/BaseLayout.astro";
import SEO from "../components/SEO.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts, getAllCategories, getAllTags, slugify } from "../utils/posts";

const posts = await getPublishedPosts();
const [lead, ...rest] = posts;
const secondary = rest.slice(0, 3);
const moreStories = rest.slice(3);
const categories = getAllCategories(posts);
const tags = getAllTags(posts);
const contactEmail = "ajmalsworkshop@gmail.com";
---
<BaseLayout>
  <SEO
    slot="head"
    title="Embedded & Circuits — Arduino, ESP32 & Electronics Tutorials"
    description="A personal engineering blog covering Arduino, ESP32, sensors, embedded systems, and IoT — practical tutorials, wiring guides, and project documentation."
    path="/"
  />

  {lead && (
    <section class="container hero-package" aria-label="Top story">
      <PostCard post={lead} variant="lead" />
      {secondary.length > 0 && (
        <div class="secondary-list">
          {secondary.map((post) => <PostCard post={post} variant="list" />)}
        </div>
      )}
    </section>
  )}

  <div class="container page-grid" style="padding-top: var(--space-10);">
    <div>
      {moreStories.length > 0 && (
        <>
          <div class="section-head">
            <h2>Latest Articles</h2>
            <a href="/blog/">View all</a>
          </div>
          <div class="post-grid">
            {moreStories.map((post) => <PostCard post={post} />)}
          </div>
        </>
      )}

      {posts.length === 0 && (
        <p class="text-muted">No articles published yet — check back soon.</p>
      )}

      <section aria-labelledby="topics-heading" style="margin-top: var(--space-12);">
        <div class="section-head">
          <h2 id="topics-heading">Browse by Topic</h2>
        </div>
        <div class="tag-cloud">
          {categories.map((cat) => (
            <a class="badge" href={`/blog/category/${slugify(cat)}/`}>{cat}</a>
          ))}
          {tags.map((tag) => (
            <a class="badge" href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a>
          ))}
        </div>
      </section>
    </div>

    <aside aria-label="Sidebar">
      <div class="widget">
        <h2 class="widget-title">Popular Topics</h2>
        <ul class="widget-list">
          {tags.slice(0, 6).map((tag) => (
            <li><a href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a></li>
          ))}
        </ul>
      </div>

      <div class="widget">
        <h2 class="widget-title">Sections</h2>
        <ul class="widget-list">
          {categories.map((cat) => (
            <li><a href={`/blog/category/${slugify(cat)}/`}>{cat}</a></li>
          ))}
        </ul>
      </div>

      <div class="widget">
        <h2 class="widget-title">About This Blog</h2>
        <p class="text-muted" style="font-size:0.9rem; margin:0 0 var(--space-3);">
          I'm Ajmal Ali. I document Arduino, ESP32, and sensor projects as I
          learn — what worked, what didn't, and why.
        </p>
        <a href="/about/" style="font-weight:700;">Read more →</a>
        <p class="text-muted" style="font-size:0.85rem; margin:var(--space-4) 0 0;">
          Corrections or topic ideas: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
