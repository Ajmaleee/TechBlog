---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SEO from "../../../components/SEO.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPublishedPosts, getAllTags, slugify } from "../../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout>
  <SEO slot="head" title={`#${tag} | Embedded & Circuits`} description={`Articles tagged ${tag}.`} path={`/blog/tag/${slugify(tag)}/`} />
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb" style="padding-top: var(--space-6);">
      <a href="/">Home</a> / <a href="/blog/">Articles</a> / <span aria-current="page">#{tag}</span>
    </nav>
    <header class="archive-head" style="border-top: none; padding-top: 0;">
      <span class="kicker">Tag</span>
      <h1>#{tag}</h1>
      <p>{posts.length} article{posts.length === 1 ? "" : "s"} tagged “{tag}”.</p>
    </header>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
