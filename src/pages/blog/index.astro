---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SEO from "../../components/SEO.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts, getAllCategories, slugify } from "../../utils/posts";

const POSTS_PER_PAGE = 12;
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const hasMore = allPosts.length > POSTS_PER_PAGE;
const categories = getAllCategories(allPosts);
---
<BaseLayout>
  <SEO slot="head" title="Blog | Embedded & Circuits" description="Tutorials and guides on Arduino, ESP32, sensors, and embedded systems." path="/blog/" />

  <div class="container" style="padding-top: var(--space-8);">
    <h1>Blog</h1>

    <div class="meta-row" style="margin-bottom: var(--space-6);">
      <span>Categories:</span>
      {categories.map((cat) => (
        <a class="badge" href={`/blog/category/${slugify(cat)}/`}>{cat}</a>
      ))}
    </div>

    <div class="post-grid" id="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    {hasMore && (
      <div style="text-align:center; margin-top: var(--space-8);">
        <a class="btn btn-secondary" href="/blog/page/2/">Load more articles</a>
      </div>
    )}
  </div>
</BaseLayout>
