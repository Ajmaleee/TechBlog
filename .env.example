# Copy this file to .env for local development.
# In Cloudflare Pages, set these as Environment Variables in the project's
# Settings > Environment variables (Production and Preview separately).
#
# Everything here is PUBLIC by design — Astro only exposes variables
# prefixed with PUBLIC_ to the browser build. Adsterra publisher/channel IDs,
# GA4 measurement IDs, and Search Console verification tokens are all designed
# to be visible in page source. Do not put real secrets (API keys, OAuth
# tokens) in PUBLIC_ variables or in this repo at all.

# The canonical production URL. Used to generate canonical links, the
# sitemap, RSS feed, and Open Graph tags. No trailing slash.
PUBLIC_SITE_URL=https://example.com

# Adsterra publisher/channel embed. Public by design.
# A production default is built into the code (see AdSlot.astro), so a normal
# deploy needs nothing here. Set to "false" to disable ads entirely.
PUBLIC_ADSTERRA_ENABLED=true

# Cookie consent (Google Consent Mode v2 + the accept/reject notice).
# A production default is built in; set to "false" to omit the notice and
# consent signals entirely (e.g. if you switch to a third-party CMP).
PUBLIC_CONSENT_ENABLED=true

# Google Analytics (GA4). Format: "G-XXXXXXXXXX".
# A production default is built into the code (see Analytics.astro), so a
# normal deploy needs nothing here. Set this to override, or to an empty
# value in a deploy to keep analytics off.
PUBLIC_GA_ID=

# Google Search Console site verification (optional). If set, a
# verification meta tag can be added in BaseLayout.astro. Do not commit a
# real verification code to a public repo unless you're fine with it being
# public (it is not a secret, but keep it accurate).
PUBLIC_GSC_VERIFICATION=
